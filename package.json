{
  "name": "@tager/admin-banners",
  "version": "1.0.1",
  "license": "MIT",
  "main": "dist/index.umd.js",
  "module": "dist/index.esm.js",
  "types": "dist/main.d.ts",
  "files": [
    "dist",
    "typings",
    "src"
  ],
  "exports": {
    "./css": "./dist/style.css",
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "build:js": "vite build",
    "build:package": "yarn build:js && (yarn emit-declarations || echo 'vue-tsc: type errors found, declarations emitted anyway')",
    "emit-declarations": "vue-tsc --project tsconfig.json --emitDeclarationOnly",
    "start": "vite",
    "prepare": "yarn build:package",
    "tager:update": "yarn upgrade --latest --scope @tager",
    "lint": "eslint .",
    "format": "prettier --write src"
  },
  "dependencies": {
    "filesize": "^9.0.11",
    "lodash.isequal": "^4.5.0",
    "lodash.kebabcase": "^4.1.1",
    "lodash.pick": "^4.4.0",
    "path-to-regexp": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tager/admin-dynamic-field": "^1.0.0",
    "@tager/admin-layout": "^1.0.0",
    "@tager/admin-services": "^1.0.0",
    "@tager/admin-ui": "^1.0.1",
    "@types/filesize": "^5.0.0",
    "@types/lodash.isequal": "^4.5.6",
    "@types/lodash.pick": "^4.4.7",
    "@types/node": "16.x",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "core-js": "^3.22.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.5.0",
    "pinia": "^2.0.21",
    "prettier": "^3.9.10",
    "sass": "^1.51.0",
    "sass-loader": "^12.6.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vue": "^3.2.31",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.0.14",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "@tager/admin-layout": "^1.0.0",
    "@tager/admin-services": "^1.0.0",
    "@tager/admin-ui": "^1.0.1",
    "vue": "^3.2.31",
    "vue-router": "^4.0.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
